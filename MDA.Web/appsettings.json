{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaConsumerConfig": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "mda.web.dev",
    "EnableAutoCommit": false,
    "MaxPollIntervalMs": 300000,
    "SessionTimeoutMs": 10000,
    "Topics": [ "dev.mda.ib.notification.v1", "dev.mda.ib.account.update.v1" ]
  }
}
